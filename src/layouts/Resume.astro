---
import: 'github-markdown-css/github-markdown-light.css';
const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <main>
      	<article class="markdown-body">
    		<slot />
		</article>
    </main>
  </body>
</html>